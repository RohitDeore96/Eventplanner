{
  "name": "utsav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier --check . --ignore-path .prettierignore",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "mutation": "stryker run",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "unused": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "bench": "tsx scripts/bench-engine.ts",
    "check": "npm run format && npm run lint && npm run typecheck && npm run arch && npm run unused && npm run test:cov",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "tsx scripts/dev-api.ts",
    "test:e2e": "playwright test",
    "smoke:ai": "node scripts/live-ai-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "qs": "^6.16.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  }
}
