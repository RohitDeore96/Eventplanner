{
  "name": "utsav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "mutation": "stryker run",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "unused": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "bench": "tsx scripts/bench-engine.ts",
    "check": "npm run format && npm run lint && npm run typecheck && npm run arch && npm run unused && npm run test:cov"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
