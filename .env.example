# Copy to .env for local dev. NEVER commit .env. The AI provider key is read ONLY inside
# serverless functions (api/), never in browser code, never logged.
# Without a key the app still works: every AI feature has a deterministic fallback.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: put a specific model first in the chain (default chain: api/_lib/models.ts)
GEMINI_MODEL=

# Optional: daily global cap on AI calls per serverless instance (graceful fallback when hit)
AI_DAILY_CAP=2000
